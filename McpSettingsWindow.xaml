<Window x:Class="HttpTraceAnalyser.McpSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCP Server Settings" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" Click="OkButton_Click" IsDefault="True" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Listening port" FontWeight="Bold" />
            <TextBlock TextWrapping="Wrap" Margin="0,2,0,6" Text="The port the in-process MCP HTTP server binds to on the loopback interface (127.0.0.1). Takes effect the next time the server is enabled." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBox x:Name="PortTextBox" Width="100" HorizontalAlignment="Left" />
                <Button Content="Reset to default" Margin="12,0,0,0" Click="ResetPortButton_Click" />
            </StackPanel>
            <TextBlock x:Name="PortErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,0" />

            <Separator Margin="0,12,0,12" />

            <TextBlock Text="GitHub Copilot CLI integration" FontWeight="Bold" />
            <TextBlock TextWrapping="Wrap" Margin="0,2,0,6" Text="With the app running and the MCP Server enabled (see the MCP Server ribbon group), register it as an HTTP MCP server in your Copilot CLI MCP configuration file:" />
            <TextBox x:Name="ConfigSnippetText" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="120" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="Verify it is registered with: gh copilot mcp list" />
        </StackPanel>
    </DockPanel>
</Window>
