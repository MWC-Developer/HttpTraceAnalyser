<?xml version="1.0"?>
<SyntaxDefinition name="XML-Dark" extensions=".xml;.xsl;.xslt;.xsd;.manifest;.config;.addin;.xshd;.wxs;.wxi;.wxl;.proj;.csproj;.vbproj;.ilproj;.booproj;.build;.xfrm;.targets;.xaml;.xpt;.xft;.map;.wsdl;.disco;.ps1xml;.nuspec" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955" />
  <Color name="CData" foreground="#E9D585" />
  <Color name="DocType" foreground="#569CD6" />
  <Color name="XmlDeclaration" foreground="#569CD6" />
  <Color name="XmlTag" foreground="#808080" />
  <Color name="AttributeName" foreground="#9CDCFE" />
  <Color name="AttributeValue" foreground="#CE9178" />
  <Color name="Entity" foreground="#B5CEA8" />
  <Color name="BrokenEntity" foreground="#F48771" />

  <RuleSet>
	<Span color="Comment" multiline="true">
	  <Begin>&lt;!--</Begin>
	  <End>--&gt;</End>
	</Span>

	<Span color="CData" multiline="true">
	  <Begin>&lt;!\[CDATA\[</Begin>
	  <End>]]&gt;</End>
	</Span>

	<Span color="DocType" multiline="true">
	  <Begin>&lt;!DOCTYPE</Begin>
	  <End>&gt;</End>
	</Span>

	<Span color="XmlDeclaration" multiline="true">
	  <Begin>&lt;\?</Begin>
	  <End>\?&gt;</End>
	</Span>

	<Span color="XmlTag" multiline="true">
	  <Begin>&lt;</Begin>
	  <End>&gt;</End>
	  <RuleSet>
		<Span color="AttributeValue" multiline="true">
		  <Begin>"</Begin>
		  <End>"</End>
		  <RuleSet>
			<Span begin="\\." end="." />
		  </RuleSet>
		</Span>
		<Span color="AttributeValue" multiline="true">
		  <Begin>'</Begin>
		  <End>'</End>
		  <RuleSet>
			<Span begin="\\." end="." />
		  </RuleSet>
		</Span>
		<Rule color="AttributeName">[\d\w_\-\.]+(?=(\s*=))</Rule>
		<Rule color="AttributeValue">=</Rule>
	  </RuleSet>
	</Span>

	<Rule color="Entity">
	  &amp;[\w\d#]+;
	</Rule>

	<Rule color="BrokenEntity">
	  &amp;[\w\d]*#?[\w\d]*;
	</Rule>
  </RuleSet>
</SyntaxDefinition>
