<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">

    <!--
        Window, TextBox, RichTextBox, ListView, GridViewColumnHeader, DataGrid*,
        TabControl/TabItem, ContextMenu/MenuItem, ComboBox, Button and
        ToggleButton are intentionally left without custom styles: WPF's
        built-in Fluent theme (enabled via Application.ThemeMode in App.xaml)
        themes all of these controls correctly for both light and dark mode.
    -->

    <Style TargetType="{x:Type ToolBarTray}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style TargetType="{x:Type ToolBar}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    </Style>

    <!--
        AvalonEdit's TextEditor is a third-party control not themed by Fluent,
        so it still needs explicit brushes.
    -->
    <Style TargetType="{x:Type avalonedit:TextEditor}">
        <Setter Property="Background" Value="{DynamicResource TextControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

</ResourceDictionary>
