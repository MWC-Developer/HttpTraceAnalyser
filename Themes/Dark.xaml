<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme using VS-inspired dark colors with better contrast -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#FFB0B0B0" />
    <SolidColorBrush x:Key="SplitterBackgroundBrush" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#B0000000" />
    <SolidColorBrush x:Key="OverlayCardBackgroundBrush" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="OverlayCardBorderBrush" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#FF007ACC" />
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ImageBackgroundBrush" Color="#FFFFFFFF" />
</ResourceDictionary>
