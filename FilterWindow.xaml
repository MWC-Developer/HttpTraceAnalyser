<Window x:Class="HttpTraceAnalyser.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:model="clr-namespace:HttpTraceAnalyser.Model"
        Title="Filter" Height="420" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <ObjectDataProvider x:Key="FilterCombinatorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:FilterCombinator" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="FilterComparatorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:FilterComparator" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <DockPanel Margin="8">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Load..." Width="80" Margin="0,0,8,0" Click="LoadButton_Click" />
                <Button Content="Save As..." Width="80" Click="SaveButton_Click" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Set Default" Width="90" Click="SetDefaultButton_Click" />
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Add" Width="80" Margin="0,0,8,0" Click="AddButton_Click" />
                <Button Content="Remove" Width="80" Click="RemoveButton_Click" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click" />
                <Button Content="Cancel" Width="80" IsCancel="True" />
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap"
               Text="Rules are combined left-to-right using each rule's combinator; the first rule's combinator is ignored." />

        <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridComboBoxColumn Header="Combinator"
                                        ItemsSource="{Binding Source={StaticResource FilterCombinatorValues}}"
                                        SelectedItemBinding="{Binding Combinator}"
                                        Width="90" />
                <DataGridComboBoxColumn Header="Column"
                                        ItemsSource="{x:Static model:TraceColumnCatalog.Names}"
                                        SelectedItemBinding="{Binding ColumnName}"
                                        Width="150" />
                <DataGridComboBoxColumn Header="Comparator"
                                        ItemsSource="{Binding Source={StaticResource FilterComparatorValues}}"
                                        SelectedItemBinding="{Binding Comparator}"
                                        Width="150" />
                <DataGridTextColumn Header="Value"
                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
