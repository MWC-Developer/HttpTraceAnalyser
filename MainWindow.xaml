<Window x:Class="HttpTraceAnalyser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HttpTraceAnalyser"
        xmlns:model="clr-namespace:HttpTraceAnalyser.Model"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="HTTP Trace Analyser" Height="800" Width="1600"
        WindowState="Normal"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Icon="HttpTraceAnalyser.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="FindCommand_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
    </Window.InputBindings>
    <Window.Resources>
        <!-- Ribbon-style toolbar resources -->
        <Style x:Key="RibbonButtonStyle" TargetType="{x:Type ButtonBase}">
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ButtonBase}">
                        <Border x:Name="RibbonButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock x:Name="RibbonButtonIcon"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="20"
                                           HorizontalAlignment="Center" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="RibbonButtonIcon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RibbonButtonBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="RibbonButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RibbonButtonBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                <Setter TargetName="RibbonButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonGroupStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style x:Key="RibbonToggleButtonStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource RibbonButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RibbonGroupLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>
    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <Button x:Name="AppSettingsButton" DockPanel.Dock="Right"
                            Content="App Settings" Tag="&#xE713;"
                            Margin="4,3"
                            VerticalAlignment="Center"
                            Style="{StaticResource RibbonButtonStyle}"
                            Click="AppSettingsButton_Click" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- View group -->
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="FilterButton" Content="Filter"
                                            Tag="&#xE71C;"
                                            Style="{StaticResource RibbonButtonStyle}"
                                            Click="FilterButton_Click" />
                                    <Button x:Name="HighlightsButton" Content="Highlights"
                                            Tag="&#xE12F;"
                                            Style="{StaticResource RibbonButtonStyle}"
                                            Click="HighlightsButton_Click" />
                                        <Button x:Name="CustomColumnsButton" Content="Custom Columns"
                                            Tag="&#xF0E2;"
                                            Style="{StaticResource RibbonButtonStyle}"
                                            Click="CustomColumnsButton_Click" />
                                </StackPanel>
                                <TextBlock Text="View" Style="{StaticResource RibbonGroupLabelStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Navigation group -->
                        <Border Style="{StaticResource RibbonGroupStyle}" BorderThickness="0">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PreviousErrorButton" Content="Previous Error"
                                            Tag="&#xE74A;"
                                            Style="{StaticResource RibbonButtonStyle}"
                                            Click="PreviousErrorButton_Click" />
                                    <Button x:Name="NextErrorButton" Content="Next Error"
                                            Tag="&#xE74B;"
                                            Style="{StaticResource RibbonButtonStyle}"
                                            Click="NextErrorButton_Click" />
                                </StackPanel>
                                <TextBlock Text="Navigation" Style="{StaticResource RibbonGroupLabelStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- MCP Server group -->
                        <Border Style="{StaticResource RibbonGroupStyle}" BorderThickness="0">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="McpServerButton" Content="Enable"
                                                  Tag="&#xE8CD;"
                                                  Style="{StaticResource RibbonToggleButtonStyle}"
                                                  Checked="McpServerButton_Checked"
                                                  Unchecked="McpServerButton_Unchecked" />
                                </StackPanel>
                                <TextBlock Text="MCP Server" Style="{StaticResource RibbonGroupLabelStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

        <Grid x:Name="WorkspaceGrid">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="SessionsRow" Height="*" MinHeight="0" />
                <RowDefinition x:Name="HorizontalSplitterRow" Height="0" />
                <RowDefinition x:Name="SplitDetailsRow" Height="0" MinHeight="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerRailColumn" Width="Auto" />
                <ColumnDefinition x:Name="ExplorerColumn" Width="240" MinWidth="150" MaxWidth="600" />
                <ColumnDefinition x:Name="ExplorerSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="SessionsColumn" Width="900" MinWidth="400" />
                <ColumnDefinition x:Name="VerticalSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="TabbedDetailsColumn" Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ExplorerRail" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="Collapsed">
                <Button Content="&#xE76C;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Width="28" Margin="0,6,0,0" Padding="4"
                        VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Expand the sessions panel"
                        Click="CollapseExplorerButton_Click" />
            </Border>

            <Border x:Name="SessionsExplorerPane" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1" Padding="8,6">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="&#xE76B;"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Padding="6,2" ToolTip="Collapse the sessions panel"
                                    Click="CollapseExplorerButton_Click" />
                            <Button DockPanel.Dock="Right" x:Name="AddSessionButton" Content="&#xE710;" Margin="0,0,4,0"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Padding="6,2" ToolTip="Load an additional trace as a new session"
                                    Click="AddSessionButton_Click" />
                            <TextBlock DockPanel.Dock="Left" Text="Sessions" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="SessionsListBox" DockPanel.Dock="Top" BorderThickness="0"
                             Background="Transparent"
                             SelectionMode="Single"
                             SelectionChanged="SessionsListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Path}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="{Binding IsActiveFontWeight}" />
                                    <Button Grid.Column="1" Content="&#xE711;" Tag="{Binding Id}"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            FontSize="10" Width="20" Height="20" Padding="0"
                                            Margin="4,0,0,0"
                                            ToolTip="Close this session"
                                            Click="CloseSessionButton_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="ExplorerSplitter" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                          Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True" />

            <Grid x:Name="SessionsPane" Grid.Row="0" Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="FindSessionsBar" Grid.Row="0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="6" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="&#xE711;" Margin="4,0,0,0"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Padding="7,2" ToolTip="Close" Click="CloseFindButton_Click" />
                    <Button DockPanel.Dock="Right" Content="&#xE72A;" Margin="4,0,0,0"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Padding="7,2" ToolTip="Next match (Enter)" Click="FindNextButton_Click" />
                    <Button DockPanel.Dock="Right" Content="&#xE70E;" Margin="4,0,0,0"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Padding="7,2" ToolTip="Previous match (Shift+Enter)" Click="FindPreviousButton_Click" />
                    <TextBlock x:Name="FindSessionsStatus" DockPanel.Dock="Right"
                           Margin="8,0,4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          <TextBlock DockPanel.Dock="Left" Text="Find" Margin="0,0,8,0"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
                          <ComboBox x:Name="FindScopeCombo" DockPanel.Dock="Left" Width="150" Margin="0,0,6,0"
                              SelectedIndex="0" SelectionChanged="FindScopeCombo_SelectionChanged">
                           <ComboBoxItem Content="All sessions" />
                           <ComboBoxItem Content="Request headers" />
                           <ComboBoxItem Content="Request body" />
                           <ComboBoxItem Content="Response headers" />
                           <ComboBoxItem Content="Response body" />
                          </ComboBox>
                    <TextBox x:Name="FindSessionsText" VerticalContentAlignment="Center"
                         KeyDown="FindSessionsText_KeyDown" TextChanged="FindSessionsText_TextChanged" />
                    </DockPanel>
                </Border>

                <ListView x:Name="RequestList" Grid.Row="1"
                          SelectionMode="Extended"
                          SelectionChanged="RequestList_SelectionChanged"
                          PreviewMouseRightButtonDown="RequestList_PreviewMouseRightButtonDown"
                          GridViewColumnHeader.Click="RequestList_HeaderClick"
                          ContextMenuOpening="RequestList_ContextMenuOpening"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.Resources>
                    <!-- Compact header padding; Fluent's default GridViewColumnHeader padding is much taller. -->
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Padding" Value="6,2" />
                    </Style>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                        <Setter Property="Padding" Value="4,1" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Background"
                                Value="{Binding RowBackground,
                                                TargetNullValue={x:Null},
                                                FallbackValue={x:Null}}" />
                        <Setter Property="Foreground">
                            <Setter.Value>
                                <MultiBinding Converter="{x:Static local:RowForegroundMultiConverter.Instance}">
                                    <Binding Path="RowForeground" />
                                    <Binding Path="RowBackground" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="SelectionBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        Margin="0,0,14,0">
                                    <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                          Columns="{TemplateBinding GridView.ColumnCollection}"
                                                          Margin="0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="SelectionBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ContextMenu>
                    <ContextMenu Closed="RequestList_ContextMenuClosed">
                        <MenuItem Header="Remove" Click="RemoveItems_Click" />
                        <Separator />
                        <MenuItem x:Name="FilterMenuItem" Header="Filter">
                            <MenuItem x:Name="FilterCurrentCellMenuItem" Click="FilterCurrentCellMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="FilterHostMenuItem" Click="FilterMenuItem_Click" />
                            <MenuItem x:Name="ExcludeHostMenuItem" Click="FilterMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="FilterMethodMenuItem" Click="FilterMenuItem_Click" />
                            <MenuItem x:Name="ExcludeMethodMenuItem" Click="FilterMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="FilterPathMenuItem" Click="FilterMenuItem_Click" />
                            <MenuItem x:Name="ExcludePathMenuItem" Click="FilterMenuItem_Click" />
                        </MenuItem>
                        <MenuItem x:Name="HighlightMenuItem" Header="Highlight">
                            <MenuItem x:Name="HighlightCurrentCellMenuItem" Click="HighlightCurrentCellMenuItem_Click" />
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Date" IsCheckable="True" IsChecked="False"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed">
                                    <MenuItem.Tag>
                                        <GridViewColumn Header="Date" Width="200"
                                                        DisplayMemberBinding="{Binding Date}" />
                                    </MenuItem.Tag>
                                </MenuItem>
                                <MenuItem Header="Time" IsCheckable="True" IsChecked="True"
                                          Tag="{x:Reference TimeColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="Method" IsCheckable="True" IsChecked="True"
                                          Tag="{x:Reference MethodColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="Response" IsCheckable="True" IsChecked="True"
                                          Tag="{x:Reference ResponseColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="URL" IsCheckable="True" IsChecked="False"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed">
                                    <MenuItem.Tag>
                                        <GridViewColumn Header="URL" Width="200"
                                                        DisplayMemberBinding="{Binding Url}" />
                                    </MenuItem.Tag>
                                </MenuItem>
                                <MenuItem Header="Host" IsCheckable="True" IsChecked="True"
                                          Tag="{x:Reference HostColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="Path" IsCheckable="True" IsChecked="True"
                                          Tag="{x:Reference PathColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="Latency (ms)" IsCheckable="True" IsChecked="True"
                                          Tag="{x:Reference LatencyColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem x:Name="ProcessColumnMenuItem" Header="Process" IsCheckable="True" IsChecked="False"
                                          Visibility="Collapsed"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed">
                                    <MenuItem.Tag>
                                        <GridViewColumn Header="Process" Width="160"
                                                        DisplayMemberBinding="{Binding Process}" />
                                    </MenuItem.Tag>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Content-Type" IsCheckable="True" IsChecked="False"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed">
                                    <MenuItem.Tag>
                                        <GridViewColumn Header="Content-Type" Width="200"
                                                        DisplayMemberBinding="{Binding ContentType}" />
                                    </MenuItem.Tag>
                                </MenuItem>
                                <MenuItem Header="Client-Request-Id" IsCheckable="True" IsChecked="False"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed">
                                    <MenuItem.Tag>
                                        <GridViewColumn Header="Client-Request-Id" Width="200"
                                                        DisplayMemberBinding="{Binding ClientRequestId}" />
                                    </MenuItem.Tag>
                                </MenuItem>
                                <MenuItem Header="SOAP Method" IsCheckable="True" IsChecked="False"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed">
                                    <MenuItem.Tag>
                                        <GridViewColumn Header="SOAP Method" Width="200"
                                                        DisplayMemberBinding="{Binding SoapMethod}" />
                                    </MenuItem.Tag>
                                </MenuItem>
                                <MenuItem Header="X-RequestId" IsCheckable="True" IsChecked="False"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed">
                                    <MenuItem.Tag>
                                        <GridViewColumn Header="X-RequestId" Width="200"
                                                        DisplayMemberBinding="{Binding XRequestId}" />
                                    </MenuItem.Tag>
                                </MenuItem>
                                <Separator x:Name="ColumnActionsSeparator" />
                                <MenuItem Header="Auto-size Columns" Click="AutoSizeColumns_Click" />
                            </ContextMenu>
                        </GridView.ColumnHeaderContextMenu>
                        <GridViewColumn x:Name="TimeColumn" Header="Time" Width="90"
                                        DisplayMemberBinding="{Binding Time}" />
                        <GridViewColumn x:Name="MethodColumn" Header="Method" Width="70"
                                        DisplayMemberBinding="{Binding Method}" />
                        <GridViewColumn x:Name="ResponseColumn" Header="Response" Width="55"
                                        DisplayMemberBinding="{Binding Response}" />
                        <GridViewColumn x:Name="LatencyColumn" Header="Latency (ms)" Width="90"
                                        DisplayMemberBinding="{Binding Latency, StringFormat=N0}" />
                        <GridViewColumn x:Name="HostColumn" Header="Host" Width="160"
                                        DisplayMemberBinding="{Binding Host}" />
                        <GridViewColumn x:Name="PathColumn" Header="Path" Width="240"
                                        DisplayMemberBinding="{Binding Path}" />
                    </GridView>
                </ListView.View>
            </ListView>
            </Grid>

            <GridSplitter x:Name="VerticalWorkspaceSplitter"
                          Grid.Row="0" Grid.Column="4" Width="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource ControlFillColorDefaultBrush}" />

            <TabControl Grid.Row="0" Grid.Column="5" x:Name="MainTabControl"
                        SelectionChanged="MainTabControl_SelectionChanged"
                        PreviewMouseDown="MainTabControl_PreviewMouseDown">
                <TabItem x:Name="SummaryTab" Header="Summary">
                    <RichTextBox x:Name="SummaryViewer" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas">
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="ApplicationCommands.Copy" />
                                <MenuItem Command="ApplicationCommands.SelectAll" />
                                <Separator />
                                <MenuItem Header="Word wrap" IsCheckable="True" IsChecked="True"
                                          Click="WordWrap_Toggled" />
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                </TabItem>
                <TabItem x:Name="RequestTab" Header="Request">
                    <Grid x:Name="RequestViewerGrid" SizeChanged="RequestViewerGrid_SizeChanged" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="RequestHeadersRow" Height="Auto" />
                            <RowDefinition x:Name="RequestSplitterRow" Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="RequestPayloadRow" Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Headers" FontWeight="Bold" Margin="4,4,4,2" />
                        <Grid Grid.Row="1" x:Name="RequestHeadersPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="RequestHeadersFindBar" Grid.Row="0" Visibility="Collapsed"
                                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1" Padding="4">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="&#xE711;" Tag="RequestHeaders"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="7,2"
                                            ToolTip="Close" Click="LocalFindCloseButton_Click" />
                                    <Button DockPanel.Dock="Right" Content="&#xE72A;" Tag="RequestHeaders" Margin="4,0,0,0"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="7,2"
                                            ToolTip="Next match (Enter)" Click="LocalFindNextButton_Click" />
                                    <Button DockPanel.Dock="Right" Content="&#xE70E;" Tag="RequestHeaders" Margin="4,0,0,0"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="7,2"
                                            ToolTip="Previous match (Shift+Enter)" Click="LocalFindPreviousButton_Click" />
                                    <TextBlock x:Name="RequestHeadersFindStatus" DockPanel.Dock="Right" Margin="8,0,4,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock DockPanel.Dock="Left" Text="Find" Margin="0,0,8,0"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBox x:Name="RequestHeadersFindText" Tag="RequestHeaders"
                                             VerticalContentAlignment="Center" KeyDown="LocalFindText_KeyDown"
                                             TextChanged="LocalFindText_TextChanged" />
                                </DockPanel>
                            </Border>
                        <TextBox Grid.Row="1" x:Name="RequestHeadersText" IsReadOnly="True"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 FontFamily="Consolas" TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="ApplicationCommands.Copy" />
                                    <MenuItem Command="ApplicationCommands.SelectAll" />
                                    <Separator />
                                    <MenuItem Header="Word wrap" IsCheckable="True"
                                              Click="WordWrap_Toggled" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                        </Grid>
                        <GridSplitter x:Name="RequestPayloadSplitter" Grid.Row="2" Height="4"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      Background="{DynamicResource ControlFillColorDefaultBrush}" />
                        <StackPanel Grid.Row="3" x:Name="RequestPayloadFormatPanel"
                                    Orientation="Horizontal" Margin="4,4,4,2">
                            <TextBlock Text="Viewer format:" VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ComboBox x:Name="RequestPayloadFormatCombo" Width="120"
                                      SelectionChanged="RequestPayloadFormat_Changed">
                                <ComboBoxItem Content="Plain text" />
                                <ComboBoxItem Content="JSON" />
                                <ComboBoxItem Content="XML" />
                                <ComboBoxItem Content="HTML" />
                                <ComboBoxItem Content="JavaScript" />
                                <ComboBoxItem Content="Image" />
                                <ComboBoxItem Content="SVG" />
                            </ComboBox>
                            <TextBlock x:Name="RequestContentTypeText" VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="4" x:Name="RequestBodyPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="RequestBodyFindBar" Grid.Row="0" Visibility="Collapsed"
                                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1" Padding="4">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="&#xE711;" Tag="RequestBody"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="7,2"
                                            ToolTip="Close" Click="LocalFindCloseButton_Click" />
                                    <Button DockPanel.Dock="Right" Content="&#xE72A;" Tag="RequestBody" Margin="4,0,0,0"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="7,2"
                                            ToolTip="Next match (Enter)" Click="LocalFindNextButton_Click" />
                                    <Button DockPanel.Dock="Right" Content="&#xE70E;" Tag="RequestBody" Margin="4,0,0,0"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="7,2"
                                            ToolTip="Previous match (Shift+Enter)" Click="LocalFindPreviousButton_Click" />
                                    <TextBlock x:Name="RequestBodyFindStatus" DockPanel.Dock="Right" Margin="8,0,4,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock DockPanel.Dock="Left" Text="Find" Margin="0,0,8,0"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBox x:Name="RequestBodyFindText" Tag="RequestBody"
                                             VerticalContentAlignment="Center" KeyDown="LocalFindText_KeyDown"
                                             TextChanged="LocalFindText_TextChanged" />
                                </DockPanel>
                            </Border>
                            <avalonedit:TextEditor Grid.Row="1" x:Name="RequestPayloadEditor"
                                                   IsReadOnly="True" ShowLineNumbers="True"
                                                   FontFamily="Consolas"
                                                   VerticalScrollBarVisibility="Auto"
                                                   HorizontalScrollBarVisibility="Auto">
                                <avalonedit:TextEditor.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="ApplicationCommands.Copy" />
                                        <MenuItem Command="ApplicationCommands.SelectAll" />
                                        <Separator />
                                        <MenuItem Header="Word wrap" IsCheckable="True"
                                                  Click="WordWrap_Toggled" />
                                    </ContextMenu>
                                </avalonedit:TextEditor.ContextMenu>
                            </avalonedit:TextEditor>
                            <ScrollViewer Grid.Row="1" x:Name="RequestPayloadImageScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="White"
                                          Visibility="Collapsed">
                                <Image x:Name="RequestPayloadImage" Stretch="None"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </ScrollViewer>
                            <ScrollViewer Grid.Row="1" x:Name="RequestPayloadSvgScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="White"
                                          Visibility="Collapsed">
                                <svgc:SvgViewbox x:Name="RequestPayloadSvg"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top" />
                            </ScrollViewer>
                            <TextBlock Grid.Row="1" x:Name="RequestNoPayloadText" Text="(no payload)"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Padding="6"
                                       VerticalAlignment="Top" HorizontalAlignment="Left"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="ResponseTab" Header="Response">
                    <Grid x:Name="ResponseViewerGrid" SizeChanged="ResponseViewerGrid_SizeChanged" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="ResponseHeadersRow" Height="Auto" />
                            <RowDefinition x:Name="ResponseSplitterRow" Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="ResponsePayloadRow" Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Headers" FontWeight="Bold" Margin="4,4,4,2" />
                        <Grid Grid.Row="1" x:Name="ResponseHeadersPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="ResponseHeadersFindBar" Grid.Row="0" Visibility="Collapsed"
                                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1" Padding="4">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="&#xE711;" Tag="ResponseHeaders"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="7,2"
                                            ToolTip="Close" Click="LocalFindCloseButton_Click" />
                                    <Button DockPanel.Dock="Right" Content="&#xE72A;" Tag="ResponseHeaders" Margin="4,0,0,0"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="7,2"
                                            ToolTip="Next match (Enter)" Click="LocalFindNextButton_Click" />
                                    <Button DockPanel.Dock="Right" Content="&#xE70E;" Tag="ResponseHeaders" Margin="4,0,0,0"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="7,2"
                                            ToolTip="Previous match (Shift+Enter)" Click="LocalFindPreviousButton_Click" />
                                    <TextBlock x:Name="ResponseHeadersFindStatus" DockPanel.Dock="Right" Margin="8,0,4,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock DockPanel.Dock="Left" Text="Find" Margin="0,0,8,0"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBox x:Name="ResponseHeadersFindText" Tag="ResponseHeaders"
                                             VerticalContentAlignment="Center" KeyDown="LocalFindText_KeyDown"
                                             TextChanged="LocalFindText_TextChanged" />
                                </DockPanel>
                            </Border>
                        <TextBox Grid.Row="1" x:Name="ResponseHeadersText" IsReadOnly="True"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 FontFamily="Consolas" TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="ApplicationCommands.Copy" />
                                    <MenuItem Command="ApplicationCommands.SelectAll" />
                                    <Separator />
                                    <MenuItem Header="Word wrap" IsCheckable="True"
                                              Click="WordWrap_Toggled" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                        </Grid>
                        <GridSplitter x:Name="ResponsePayloadSplitter" Grid.Row="2" Height="4"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      Background="{DynamicResource ControlFillColorDefaultBrush}" />
                        <StackPanel Grid.Row="3" x:Name="ResponsePayloadFormatPanel"
                                    Orientation="Horizontal" Margin="4,4,4,2">
                            <TextBlock Text="Viewer format:" VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ComboBox x:Name="ResponsePayloadFormatCombo" Width="120"
                                      SelectionChanged="ResponsePayloadFormat_Changed">
                                <ComboBoxItem Content="Plain text" />
                                <ComboBoxItem Content="JSON" />
                                <ComboBoxItem Content="XML" />
                                <ComboBoxItem Content="HTML" />
                                <ComboBoxItem Content="JavaScript" />
                                <ComboBoxItem Content="Image" />
                                <ComboBoxItem Content="SVG" />
                            </ComboBox>
                            <TextBlock x:Name="ResponseContentTypeText" VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="4" x:Name="ResponseBodyPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="ResponseBodyFindBar" Grid.Row="0" Visibility="Collapsed"
                                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1" Padding="4">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="&#xE711;" Tag="ResponseBody"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="7,2"
                                            ToolTip="Close" Click="LocalFindCloseButton_Click" />
                                    <Button DockPanel.Dock="Right" Content="&#xE72A;" Tag="ResponseBody" Margin="4,0,0,0"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="7,2"
                                            ToolTip="Next match (Enter)" Click="LocalFindNextButton_Click" />
                                    <Button DockPanel.Dock="Right" Content="&#xE70E;" Tag="ResponseBody" Margin="4,0,0,0"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="7,2"
                                            ToolTip="Previous match (Shift+Enter)" Click="LocalFindPreviousButton_Click" />
                                    <TextBlock x:Name="ResponseBodyFindStatus" DockPanel.Dock="Right" Margin="8,0,4,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock DockPanel.Dock="Left" Text="Find" Margin="0,0,8,0"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBox x:Name="ResponseBodyFindText" Tag="ResponseBody"
                                             VerticalContentAlignment="Center" KeyDown="LocalFindText_KeyDown"
                                             TextChanged="LocalFindText_TextChanged" />
                                </DockPanel>
                            </Border>
                            <avalonedit:TextEditor Grid.Row="1" x:Name="ResponsePayloadEditor"
                                                   IsReadOnly="True" ShowLineNumbers="True"
                                                   FontFamily="Consolas"
                                                   VerticalScrollBarVisibility="Auto"
                                                   HorizontalScrollBarVisibility="Auto">
                                <avalonedit:TextEditor.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="ApplicationCommands.Copy" />
                                        <MenuItem Command="ApplicationCommands.SelectAll" />
                                        <Separator />
                                        <MenuItem Header="Word wrap" IsCheckable="True"
                                                  Click="WordWrap_Toggled" />
                                    </ContextMenu>
                                </avalonedit:TextEditor.ContextMenu>
                            </avalonedit:TextEditor>
                            <ScrollViewer Grid.Row="1" x:Name="ResponsePayloadImageScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="White"
                                          Visibility="Collapsed">
                                <Image x:Name="ResponsePayloadImage" Stretch="None"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </ScrollViewer>
                            <ScrollViewer Grid.Row="1" x:Name="ResponsePayloadSvgScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="White"
                                          Visibility="Collapsed">
                                <svgc:SvgViewbox x:Name="ResponsePayloadSvg"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top" />
                            </ScrollViewer>
                            <TextBlock Grid.Row="1" x:Name="ResponseNoPayloadText" Text="(no payload)"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Padding="6"
                                       VerticalAlignment="Top" HorizontalAlignment="Left"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="RestTab" Header="REST">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MaxHeight="300" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <RichTextBox x:Name="RestViewer" Grid.Row="0" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas">
                            <RichTextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="ApplicationCommands.Copy" />
                                    <MenuItem Command="ApplicationCommands.SelectAll" />
                                    <Separator />
                                    <MenuItem Header="Word wrap" IsCheckable="True" IsChecked="True"
                                              Click="WordWrap_Toggled" />
                                </ContextMenu>
                            </RichTextBox.ContextMenu>
                        </RichTextBox>
                        <TreeView x:Name="RestJsonTree" Grid.Row="1"
                                  Visibility="Collapsed"
                                  ItemsSource="{Binding}"
                                  Background="{DynamicResource ApplicationBackgroundBrush}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  BorderThickness="0">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </TabItem>
                <TabItem x:Name="SoapTab" Header="SOAP">
                    <RichTextBox x:Name="SoapViewer" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas">
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="ApplicationCommands.Copy" />
                                <MenuItem Command="ApplicationCommands.SelectAll" />
                                <Separator />
                                <MenuItem Header="Word wrap" IsCheckable="True" IsChecked="True"
                                          Click="WordWrap_Toggled" />
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                </TabItem>
                <TabItem x:Name="MapiTab" Header="MAPI">
                    <RichTextBox x:Name="MapiViewer" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas">
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="ApplicationCommands.Copy" />
                                <MenuItem Command="ApplicationCommands.SelectAll" />
                                <Separator />
                                <MenuItem Header="Word wrap" IsCheckable="True" IsChecked="True"
                                          Click="WordWrap_Toggled" />
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                </TabItem>
            </TabControl>

            <GridSplitter x:Name="HorizontalWorkspaceSplitter"
                          Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3"
                          Height="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource ControlFillColorDefaultBrush}"
                          Visibility="Collapsed" />

            <TabControl x:Name="TopLayoutTabControl"
                        Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3"
                        Visibility="Collapsed">
                <TabItem x:Name="TopSummaryTab" Header="Summary" />
                <TabItem Header="Request / Response">
                    <Grid x:Name="SplitDetailsPane">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Request" FontWeight="SemiBold" Margin="6,4" />
                            <ContentControl x:Name="SplitRequestHost" Grid.Row="1" />
                        </Grid>
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="{DynamicResource ControlFillColorDefaultBrush}" />
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Response" FontWeight="SemiBold" Margin="6,4" />
                            <ContentControl x:Name="SplitResponseHost" Grid.Row="1" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="TopRestTab" Header="REST" />
                <TabItem x:Name="TopSoapTab" Header="SOAP" />
                <TabItem x:Name="TopMapiTab" Header="MAPI" />
            </TabControl>
        </Grid>
    </DockPanel>

        <Grid x:Name="BusyOverlay" Background="#80000000"
              Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    CornerRadius="4" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" />
                </Border.Effect>
                <StackPanel MinWidth="240">
                    <TextBlock x:Name="BusyText" Text="Loading trace..." FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <ProgressBar IsIndeterminate="True" Height="16" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
