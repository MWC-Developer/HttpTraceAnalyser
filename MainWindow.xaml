<Window x:Class="HttpTraceAnalyser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HttpTraceAnalyser"
        xmlns:model="clr-namespace:HttpTraceAnalyser.Model"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="HTTP Trace Analyser" Height="800" Width="1600"
        WindowState="Normal"
        Icon="HttpTraceAnalyser.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ObjectDataProvider x:Key="FilterFieldValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:FilterField" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="FilterComparatorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:FilterComparator" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="FilterCombinatorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:FilterCombinator" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Ribbon-style toolbar resources -->
        <Style x:Key="RibbonButtonStyle" TargetType="{x:Type ButtonBase}">
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ButtonBase}">
                        <Border x:Name="RibbonButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock x:Name="RibbonButtonIcon"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="20"
                                           HorizontalAlignment="Center" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="RibbonButtonIcon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RibbonButtonBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="RibbonButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RibbonButtonBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                <Setter TargetName="RibbonButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonGroupStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style x:Key="RibbonToggleButtonStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource RibbonButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RibbonGroupLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>
    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <ToggleButton x:Name="DarkModeToggle" DockPanel.Dock="Right"
                                  Content="Dark mode" Margin="4,3" Padding="10,3"
                                  VerticalAlignment="Center"
                                  Checked="DarkModeToggle_Changed"
                                  Unchecked="DarkModeToggle_Changed" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- File group -->
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="OpenFileButton" Content="Open"
                                            Tag="&#xE8E5;"
                                            Style="{StaticResource RibbonButtonStyle}"
                                            Click="OpenFileButton_Click" />
                                </StackPanel>
                                <TextBlock Text="File" Style="{StaticResource RibbonGroupLabelStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Options group -->
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="HighlightsButton" Content="Highlights"
                                            Tag="&#xE12F;"
                                            Style="{StaticResource RibbonButtonStyle}"
                                            Click="HighlightsButton_Click" />
                                </StackPanel>
                                <TextBlock Text="Options" Style="{StaticResource RibbonGroupLabelStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- View group -->
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="FilterButton" Content="Filter"
                                                  Tag="&#xE71C;"
                                                  Style="{StaticResource RibbonToggleButtonStyle}" />
                                    <Button x:Name="PreviousErrorButton" Content="Previous Error"
                                            Tag="&#xE74A;"
                                            Style="{StaticResource RibbonButtonStyle}"
                                            Click="PreviousErrorButton_Click" />
                                    <Button x:Name="NextErrorButton" Content="Next Error"
                                            Tag="&#xE74B;"
                                            Style="{StaticResource RibbonButtonStyle}"
                                            Click="NextErrorButton_Click" />
                                </StackPanel>
                                <TextBlock Text="View" Style="{StaticResource RibbonGroupLabelStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- MCP Server group -->
                        <Border Style="{StaticResource RibbonGroupStyle}" BorderThickness="0">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="McpServerButton" Content="Enable"
                                                  Tag="&#xE8CD;"
                                                  Style="{StaticResource RibbonToggleButtonStyle}"
                                                  Checked="McpServerButton_Checked"
                                                  Unchecked="McpServerButton_Unchecked" />
                                    <Button Content="Settings"
                                            Tag="&#xE713;"
                                            Style="{StaticResource RibbonButtonStyle}"
                                            Click="McpSettingsButton_Click" />
                                </StackPanel>
                                <TextBlock Text="MCP Server" Style="{StaticResource RibbonGroupLabelStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="900" MinWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="FilterEditor" Grid.Row="0"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="6"
                        Visibility="{Binding IsChecked, ElementName=FilterButton, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RuleCombinatorCombo" Grid.Column="0"
                                      Width="60" Margin="0,0,4,0"
                                      ItemsSource="{Binding Source={StaticResource FilterCombinatorValues}}"
                                      SelectedIndex="0" />
                            <ComboBox x:Name="RuleFieldCombo" Grid.Column="1"
                                      Width="90" Margin="0,0,4,0"
                                      ItemsSource="{Binding Source={StaticResource FilterFieldValues}}"
                                      SelectedIndex="0" />
                            <ComboBox x:Name="RuleComparatorCombo" Grid.Column="2"
                                      Width="110" Margin="0,0,4,0"
                                      ItemsSource="{Binding Source={StaticResource FilterComparatorValues}}"
                                      SelectedIndex="0" />
                            <TextBox x:Name="RuleValueText" Grid.Column="3" Margin="0,0,4,0"
                                     VerticalContentAlignment="Center" />
                            <Button Grid.Column="4" Content="Add" MinWidth="60" Click="AddRule_Click" />
                        </Grid>

                        <ListBox x:Name="ActiveFiltersList" Margin="0,6,0,0" MaxHeight="120"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding Source={StaticResource FilterCombinatorValues}}"
                                                  SelectedItem="{Binding Combinator}"
                                                  FontStyle="Italic" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Source={StaticResource FilterFieldValues}}"
                                                  SelectedItem="{Binding Field}"
                                                  FontWeight="Bold" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding Source={StaticResource FilterComparatorValues}}"
                                                  SelectedItem="{Binding Comparator}"
                                                  VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center" VerticalContentAlignment="Center" />
                                        <Button Grid.Column="4" Content="&#x2715;" Padding="6,0"
                                                Click="RemoveRule_Click" Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    HorizontalAlignment="Right">
                            <Button Content="Clear all" Click="ClearRules_Click" MinWidth="70" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListView x:Name="RequestList" Grid.Row="1"
                          SelectionMode="Extended"
                          SelectionChanged="RequestList_SelectionChanged"
                          GridViewColumnHeader.Click="RequestList_HeaderClick"
                          ContextMenuOpening="RequestList_ContextMenuOpening"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.Resources>
                    <!-- Compact header padding; Fluent's default GridViewColumnHeader padding is much taller. -->
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Padding" Value="6,2" />
                    </Style>
                    <!-- Style for the selection arrow indicator -->
                    <Style x:Key="SelectionArrow" TargetType="TextBlock">
                        <Setter Property="Text" Value="" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="2,0,4,0" />
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                <Setter Property="Text" Value="▶" />
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                        <Setter Property="Padding" Value="4,1" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background"
                                Value="{Binding RowBackground,
                                                TargetNullValue={x:Null},
                                                FallbackValue={x:Null}}" />
                        <Setter Property="Foreground">
                            <Setter.Value>
                                <MultiBinding Converter="{x:Static local:RowForegroundMultiConverter.Instance}">
                                    <Binding Path="RowForeground" />
                                    <Binding Path="RowBackground" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="SelectionBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Selection arrow indicator -->
                                            <TextBlock Grid.Column="0" Style="{StaticResource SelectionArrow}" />

                                            <!-- Content -->
                                            <GridViewRowPresenter Grid.Column="1"
                                                                  Content="{TemplateBinding Content}"
                                                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                                                  Margin="0" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Remove" Click="RemoveItems_Click" />
                        <Separator />
                        <MenuItem x:Name="FilterMenuItem" Header="Filter">
                            <MenuItem x:Name="FilterHostMenuItem" Click="FilterMenuItem_Click" />
                            <MenuItem x:Name="ExcludeHostMenuItem" Click="FilterMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="FilterMethodMenuItem" Click="FilterMenuItem_Click" />
                            <MenuItem x:Name="ExcludeMethodMenuItem" Click="FilterMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="FilterPathMenuItem" Click="FilterMenuItem_Click" />
                            <MenuItem x:Name="ExcludePathMenuItem" Click="FilterMenuItem_Click" />
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Date" IsCheckable="True" IsChecked="False"
                                          Tag="{x:Reference DateColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="Time" IsCheckable="True" IsChecked="True"
                                          Tag="{x:Reference TimeColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="Method" IsCheckable="True" IsChecked="True"
                                          Tag="{x:Reference MethodColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="Response" IsCheckable="True" IsChecked="True"
                                          Tag="{x:Reference ResponseColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="URL" IsCheckable="True" IsChecked="False"
                                          Tag="{x:Reference UrlColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="Host" IsCheckable="True" IsChecked="True"
                                          Tag="{x:Reference HostColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="Path" IsCheckable="True" IsChecked="True"
                                          Tag="{x:Reference PathColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="Latency (ms)" IsCheckable="True" IsChecked="True"
                                          Tag="{x:Reference LatencyColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <Separator />
                                <MenuItem Header="Content-Type" IsCheckable="True" IsChecked="False"
                                          Tag="{x:Reference ContentTypeColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="Client-Request-Id" IsCheckable="True" IsChecked="False"
                                          Tag="{x:Reference ClientRequestIdColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="SOAP Method" IsCheckable="True" IsChecked="False"
                                          Tag="{x:Reference SoapMethodColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <MenuItem Header="X-RequestId" IsCheckable="True" IsChecked="False"
                                          Tag="{x:Reference XRequestIdColumn}"
                                          Checked="ColumnVisibility_Changed" Unchecked="ColumnVisibility_Changed" />
                                <Separator />
                                <MenuItem Header="Auto-size Columns" Click="AutoSizeColumns_Click" />
                            </ContextMenu>
                        </GridView.ColumnHeaderContextMenu>
                        <GridViewColumn x:Name="DateColumn" Header="Date" Width="0"
                                        DisplayMemberBinding="{Binding Date}" />
                        <GridViewColumn x:Name="TimeColumn" Header="Time" Width="90"
                                        DisplayMemberBinding="{Binding Time}" />
                        <GridViewColumn x:Name="MethodColumn" Header="Method" Width="70"
                                        DisplayMemberBinding="{Binding Method}" />
                        <GridViewColumn x:Name="ResponseColumn" Header="Response" Width="55"
                                        DisplayMemberBinding="{Binding Response}" />
                        <GridViewColumn x:Name="LatencyColumn" Header="Latency (ms)" Width="90"
                                        DisplayMemberBinding="{Binding Latency, StringFormat=N0}" />
                        <GridViewColumn x:Name="UrlColumn" Header="URL" Width="0"
                                        DisplayMemberBinding="{Binding Url}" />
                        <GridViewColumn x:Name="HostColumn" Header="Host" Width="160"
                                        DisplayMemberBinding="{Binding Host}" />
                        <GridViewColumn x:Name="PathColumn" Header="Path" Width="240"
                                        DisplayMemberBinding="{Binding Path}" />
                        <GridViewColumn x:Name="ContentTypeColumn" Header="Content-Type" Width="0"
                                        DisplayMemberBinding="{Binding ContentType}" />
                        <GridViewColumn x:Name="ClientRequestIdColumn" Header="Client-Request-Id" Width="0"
                                        DisplayMemberBinding="{Binding ClientRequestId}" />
                        <GridViewColumn x:Name="SoapMethodColumn" Header="SOAP Method" Width="0"
                                        DisplayMemberBinding="{Binding SoapMethod}" />
                        <GridViewColumn x:Name="XRequestIdColumn" Header="X-RequestId" Width="0"
                                        DisplayMemberBinding="{Binding XRequestId}" />
                    </GridView>
                </ListView.View>
            </ListView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource ControlFillColorDefaultBrush}" />

            <TabControl Grid.Column="2" x:Name="MainTabControl" 
                        SelectionChanged="MainTabControl_SelectionChanged"
                        PreviewMouseDown="MainTabControl_PreviewMouseDown">
                <TabItem Header="Summary">
                    <RichTextBox x:Name="SummaryViewer" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas">
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="ApplicationCommands.Copy" />
                                <MenuItem Command="ApplicationCommands.SelectAll" />
                                <Separator />
                                <MenuItem Header="Word wrap" IsCheckable="True" IsChecked="True"
                                          Click="WordWrap_Toggled" />
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                </TabItem>
                <TabItem Header="Request">
                    <Grid x:Name="RequestViewerGrid" SizeChanged="RequestViewerGrid_SizeChanged" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="RequestHeadersRow" Height="Auto" />
                            <RowDefinition x:Name="RequestSplitterRow" Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="RequestPayloadRow" Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Headers" FontWeight="Bold" Margin="4,4,4,2" />
                        <TextBox Grid.Row="1" x:Name="RequestHeadersText" IsReadOnly="True"
                                 FontFamily="Consolas" TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="ApplicationCommands.Copy" />
                                    <MenuItem Command="ApplicationCommands.SelectAll" />
                                    <Separator />
                                    <MenuItem Header="Word wrap" IsCheckable="True"
                                              Click="WordWrap_Toggled" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                        <GridSplitter x:Name="RequestPayloadSplitter" Grid.Row="2" Height="4"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      Background="{DynamicResource ControlFillColorDefaultBrush}" />
                        <StackPanel Grid.Row="3" x:Name="RequestPayloadFormatPanel"
                                    Orientation="Horizontal" Margin="4,4,4,2">
                            <TextBlock Text="Viewer format:" VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ComboBox x:Name="RequestPayloadFormatCombo" Width="120"
                                      SelectionChanged="RequestPayloadFormat_Changed">
                                <ComboBoxItem Content="Plain text" />
                                <ComboBoxItem Content="JSON" />
                                <ComboBoxItem Content="XML" />
                                <ComboBoxItem Content="HTML" />
                                <ComboBoxItem Content="JavaScript" />
                                <ComboBoxItem Content="Image" />
                                <ComboBoxItem Content="SVG" />
                            </ComboBox>
                            <TextBlock x:Name="RequestContentTypeText" VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="4">
                            <avalonedit:TextEditor x:Name="RequestPayloadEditor"
                                                   IsReadOnly="True" ShowLineNumbers="True"
                                                   FontFamily="Consolas"
                                                   VerticalScrollBarVisibility="Auto"
                                                   HorizontalScrollBarVisibility="Auto">
                                <avalonedit:TextEditor.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="ApplicationCommands.Copy" />
                                        <MenuItem Command="ApplicationCommands.SelectAll" />
                                        <Separator />
                                        <MenuItem Header="Word wrap" IsCheckable="True"
                                                  Click="WordWrap_Toggled" />
                                    </ContextMenu>
                                </avalonedit:TextEditor.ContextMenu>
                            </avalonedit:TextEditor>
                            <ScrollViewer x:Name="RequestPayloadImageScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="White"
                                          Visibility="Collapsed">
                                <Image x:Name="RequestPayloadImage" Stretch="None"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </ScrollViewer>
                            <ScrollViewer x:Name="RequestPayloadSvgScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="White"
                                          Visibility="Collapsed">
                                <svgc:SvgViewbox x:Name="RequestPayloadSvg"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top" />
                            </ScrollViewer>
                            <TextBlock x:Name="RequestNoPayloadText" Text="(no payload)"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Padding="6"
                                       VerticalAlignment="Top" HorizontalAlignment="Left"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Response">
                    <Grid x:Name="ResponseViewerGrid" SizeChanged="ResponseViewerGrid_SizeChanged" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="ResponseHeadersRow" Height="Auto" />
                            <RowDefinition x:Name="ResponseSplitterRow" Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="ResponsePayloadRow" Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Headers" FontWeight="Bold" Margin="4,4,4,2" />
                        <TextBox Grid.Row="1" x:Name="ResponseHeadersText" IsReadOnly="True"
                                 FontFamily="Consolas" TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="ApplicationCommands.Copy" />
                                    <MenuItem Command="ApplicationCommands.SelectAll" />
                                    <Separator />
                                    <MenuItem Header="Word wrap" IsCheckable="True"
                                              Click="WordWrap_Toggled" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                        <GridSplitter x:Name="ResponsePayloadSplitter" Grid.Row="2" Height="4"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      Background="{DynamicResource ControlFillColorDefaultBrush}" />
                        <StackPanel Grid.Row="3" x:Name="ResponsePayloadFormatPanel"
                                    Orientation="Horizontal" Margin="4,4,4,2">
                            <TextBlock Text="Viewer format:" VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ComboBox x:Name="ResponsePayloadFormatCombo" Width="120"
                                      SelectionChanged="ResponsePayloadFormat_Changed">
                                <ComboBoxItem Content="Plain text" />
                                <ComboBoxItem Content="JSON" />
                                <ComboBoxItem Content="XML" />
                                <ComboBoxItem Content="HTML" />
                                <ComboBoxItem Content="JavaScript" />
                                <ComboBoxItem Content="Image" />
                                <ComboBoxItem Content="SVG" />
                            </ComboBox>
                            <TextBlock x:Name="ResponseContentTypeText" VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="4">
                            <avalonedit:TextEditor x:Name="ResponsePayloadEditor"
                                                   IsReadOnly="True" ShowLineNumbers="True"
                                                   FontFamily="Consolas"
                                                   VerticalScrollBarVisibility="Auto"
                                                   HorizontalScrollBarVisibility="Auto">
                                <avalonedit:TextEditor.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="ApplicationCommands.Copy" />
                                        <MenuItem Command="ApplicationCommands.SelectAll" />
                                        <Separator />
                                        <MenuItem Header="Word wrap" IsCheckable="True"
                                                  Click="WordWrap_Toggled" />
                                    </ContextMenu>
                                </avalonedit:TextEditor.ContextMenu>
                            </avalonedit:TextEditor>
                            <ScrollViewer x:Name="ResponsePayloadImageScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="White"
                                          Visibility="Collapsed">
                                <Image x:Name="ResponsePayloadImage" Stretch="None"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </ScrollViewer>
                            <ScrollViewer x:Name="ResponsePayloadSvgScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="White"
                                          Visibility="Collapsed">
                                <svgc:SvgViewbox x:Name="ResponsePayloadSvg"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top" />
                            </ScrollViewer>
                            <TextBlock x:Name="ResponseNoPayloadText" Text="(no payload)"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Padding="6"
                                       VerticalAlignment="Top" HorizontalAlignment="Left"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="REST">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MaxHeight="300" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <RichTextBox x:Name="RestViewer" Grid.Row="0" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas">
                            <RichTextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="ApplicationCommands.Copy" />
                                    <MenuItem Command="ApplicationCommands.SelectAll" />
                                    <Separator />
                                    <MenuItem Header="Word wrap" IsCheckable="True" IsChecked="True"
                                              Click="WordWrap_Toggled" />
                                </ContextMenu>
                            </RichTextBox.ContextMenu>
                        </RichTextBox>
                        <TreeView x:Name="RestJsonTree" Grid.Row="1"
                                  Visibility="Collapsed"
                                  ItemsSource="{Binding}"
                                  Background="{DynamicResource ApplicationBackgroundBrush}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  BorderThickness="0">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </TabItem>
                <TabItem Header="SOAP">
                    <RichTextBox x:Name="SoapViewer" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas">
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="ApplicationCommands.Copy" />
                                <MenuItem Command="ApplicationCommands.SelectAll" />
                                <Separator />
                                <MenuItem Header="Word wrap" IsCheckable="True" IsChecked="True"
                                          Click="WordWrap_Toggled" />
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                </TabItem>
                <TabItem Header="MAPI">
                    <RichTextBox x:Name="MapiViewer" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas">
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="ApplicationCommands.Copy" />
                                <MenuItem Command="ApplicationCommands.SelectAll" />
                                <Separator />
                                <MenuItem Header="Word wrap" IsCheckable="True" IsChecked="True"
                                          Click="WordWrap_Toggled" />
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>

        <Grid x:Name="BusyOverlay" Background="#80000000"
              Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    CornerRadius="4" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" />
                </Border.Effect>
                <StackPanel MinWidth="240">
                    <TextBlock x:Name="BusyText" Text="Loading trace..." FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <ProgressBar IsIndeterminate="True" Height="16" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
